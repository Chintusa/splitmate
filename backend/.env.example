# ============================================================
# SplitMate — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------------
# Django core
# ------------------------------------------------------------------
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key-in-production

# ------------------------------------------------------------------
# Database (MySQL)
# ------------------------------------------------------------------
DATABASE_NAME=splitmate
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# ------------------------------------------------------------------
# Frontend URL (used for CORS)
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# JWT tokens
# ------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ------------------------------------------------------------------
# OTP settings
# ------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------
# SMTP / Email
# In development leave EMAIL_BACKEND as console to print to stdout.
# For production, set EMAIL_BACKEND to smtp and fill in credentials.
# ------------------------------------------------------------------

# Use console backend for dev (no SMTP server needed):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Use SMTP backend for production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@splitmate.app
SMTP_FROM_NAME=SplitMate
